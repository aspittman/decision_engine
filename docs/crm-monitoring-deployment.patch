+++ b/tests/monitoring-capabilities.test.cjs
@@ -0,0 +1,13 @@
+const {test}=require('node:test');const assert=require('node:assert/strict');const fs=require('node:fs');const path=require('node:path');const ts=require('typescript');
+require.extensions['.ts']=(module,name)=>module._compile(ts.transpileModule(fs.readFileSync(name,'utf8').replaceAll("@/lib/",path.resolve(__dirname,'../lib')+'/'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2020,esModuleInterop:true}}).outputText,name)
+const org='11111111-1111-4111-8111-111111111111';const calls=[];let denied=false;
+const db={from(table){const call={table};calls.push(call);const q={select(columns){call.columns=columns;return q},eq(k,v){call.filter=[k,v];return q},limit(n){call.limit=n;return q},then(resolve){return Promise.resolve({data:table==='organizations'?[{id:org}]:[],error:denied&&table==='execution_requests'?{code:'42501'}:null}).then(resolve)}};return q}}
+require.cache[require.resolve('../lib/supabase-admin.ts')]={exports:{supabaseAdmin:db}}
+const {NextRequest}=require('next/server');const {GET}=require('../app/api/bot/monitoring-capabilities/route.ts');process.env.BOT_API_SECRET='test-secret';
+function request(engine='devspace_one',secret='test-secret',service='domain_merchant'){return GET(new NextRequest(`http://localhost/api/bot/monitoring-capabilities?organization_id=${org}&engine_id=${engine}&service_id=${service}`,{headers:{authorization:'Bearer '+secret}}))}
+test('authenticated checks use only bounded tenant SELECTs and accept zero rows',async()=>{calls.length=0;const response=await request();assert.equal(response.status,200);const {data}=await response.json();assert.equal(data.reads.execution_requests.status,'VERIFIED');assert.equal(data.write_status,'UNVERIFIED');assert.equal(data.connectivity_status,'CONNECTED');for(const c of calls){assert.equal(c.limit,1);if(c.table==='execution_capabilities'){assert.equal(c.columns,'status,adapter_ready,allowed_actions');assert.equal(c.filter[1],'domain_merchant')}else if(c.table==='organization_services'){assert.equal(c.columns,'is_enabled');assert.equal(c.filter[1],'domain_merchant')}else{assert.equal(c.columns,'id');assert.equal(c.filter[1],org)}}assert.equal(calls.length,4)})
+test('wrong credential rejected before any database request',async()=>{calls.length=0;assert.equal((await request('devspace_one','wrong')).status,401);assert.equal(calls.length,0)})
+test('arbitrary engines or services cannot select arbitrary tables',async()=>{calls.length=0;assert.equal((await request('secret_table')).status,400);assert.equal((await request('devspace_one','test-secret','invented')).status,400);assert.equal(calls.length,0)})
+test('permission failure is not an empty successful read',async()=>{denied=true;const {data}=await(await request()).json();assert.equal(data.reads.execution_requests.status,'FAILED');assert.equal(data.connectivity_status,'DEGRADED');denied=false})
+
+test('all five canonical Decision Engine services have bounded monitoring contracts',async()=>{for(const service of ['domain_merchant','devspace_services','devspace_clients','scholarship_research','investor_research']){calls.length=0;const response=await request('decision_engine','test-secret',service);assert.equal(response.status,200,service);const {data}=await response.json();assert.equal(data.service_id,service);assert.equal(data.engine_id,'decision_engine');assert.equal(data.reads.intelligence_reports.status,'VERIFIED');assert.equal(data.write_status,'UNVERIFIED');assert.ok(calls.every(c=>c.limit===1));assert.ok(!calls.some(c=>c.columns==='*'))}})
